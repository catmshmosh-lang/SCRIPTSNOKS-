local function createEl(class, name, text, pos, size, bgColor, textColor, strokeColor)
    local el = Instance.new(class)
    el.Name = name
    el.Position = pos
    el.Size = size
    el.BackgroundColor3 = bgColor
    el.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner", el)
    corner.CornerRadius = UDim.new(0, 6)
    
    if strokeColor then
        local stroke = Instance.new("UIStroke", el)
        stroke.Color = strokeColor
        stroke.Thickness = 1.5
    end

    if class == "TextButton" or class == "TextLabel" then
        el.Text = text
        el.Font = Enum.Font.SourceSansBold
        el.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
    end
    el.Parent = mf
    return el
end


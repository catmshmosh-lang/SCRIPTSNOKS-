local btnFly = createEl("TextButton", "btnFly", "طيران", UDim2.new(0,160, 0,100), UDim2.new(0,160, 0,50), cBlue)
btnFly.TextSize = 25

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local flying = false
local flySpeed = 50
local bv = nil
local bg = nil
local conn = nil

local isUpPressed = false
local isDownPressed = false

local function handleInput(btn, isUp)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if isUp then isUpPressed = true else isDownPressed = true end
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if isUp then isUpPressed = false else isDownPressed = false end
        end
    end)
end

handleInput(btnUp, true)
handleInput(btnDown, false)

local function stopFly()
    flying = false
    if conn then
        conn:Disconnect()
        conn = nil
    end
    if bv then
        bv:Destroy()
        bv = nil
    end
    if bg then
        bg:Destroy()
        bg = nil
    end
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        if hum then
            hum.PlatformStand = false
        end
    end
    btnFly.BackgroundColor3 = cBlue
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hrp or not hum then return end

    flying = true
    hum.PlatformStand = true

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 90000
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    btnFly.BackgroundColor3 = Color3.fromRGB(100, 255, 100)

    conn = RunService.RenderStepped:Connect(function()
        if not flying or not LocalPlayer.Character or not hrp then return end
        local cam = workspace.CurrentCamera
        bg.CFrame = cam.CFrame

        local moveDir = hum.MoveDirection
        local camCFrame = cam.CFrame
        local moveVec = camCFrame:VectorToWorldSpace(camCFrame:VectorToObjectSpace(Vector3.new(moveDir.X, 0, moveDir.Z)))

        local yMove = 0
        if isUpPressed then
            yMove = 1
        elseif isDownPressed then
            yMove = -1
        else
            yMove = camCFrame.LookVector.Y * (moveDir.Magnitude > 0 and 1 or 0)
        end

        moveVec = moveVec + Vector3.new(0, yMove, 0)

        if moveVec.Magnitude > 0 then
            bv.Velocity = moveVec.Unit * flySpeed
        else
            bv.Velocity = Vector3.zero
        end
    end)
end

btnFly.MouseButton1Click:Connect(function()
    if flying then
        stopFly()
    else
        startFly()
    end
end)

btnPlus.MouseButton1Click:Connect(function()
    flySpeed = flySpeed + 1
    lblSpeed.Text = tostring(flySpeed)
end)

btnMin.MouseButton1Click:Connect(function()
    if flySpeed > 1 then
        flySpeed = flySpeed - 1
        lblSpeed.Text = tostring(flySpeed)
    end
end)

btnX.MouseButton1Click:Connect(function()
    stopFly()
    sg:Destroy()
end)

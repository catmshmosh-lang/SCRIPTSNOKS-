local sg = Instance.new("ScreenGui")
sg.Name = "NoksFlyGui"
sg.Parent = game.CoreGui
sg.ResetOnSpawn = false

local mf = Instance.new("Frame")
mf.Size = UDim2.new(0, 320, 0, 150)
mf.Position = UDim2.new(0.5, -160, 0.5, -75)
mf.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
mf.Active = true
mf.Draggable = true
mf.Parent = sg

local cRed = Color3.fromRGB(255, 50, 50)
local cBlue = Color3.fromRGB(50, 100, 255)
local cPurple = Color3.fromRGB(150, 50, 255)
local cYellow = Color3.fromRGB(255, 255, 100)
local cOrange = Color3.fromRGB(255, 120, 0)
local cGreen = Color3.fromRGB(50, 255, 100)

local function createEl(class, name, text, pos, size, color)
    local el = Instance.new(class)
    el.Name = name
    el.Position = pos
    el.Size = size
    el.BackgroundColor3 = color
    el.BorderColor3 = Color3.fromRGB(0, 0, 0)
    el.BorderSizePixel = 3
    if class == "TextButton" or class == "TextLabel" then
        el.Text = text
        el.Font = Enum.Font.SourceSansBold
        el.TextColor3 = Color3.fromRGB(0, 0, 0)
    end
    el.Parent = mf
    return el
end

local btnX = createEl("TextButton", "btnX", "X", UDim2.new(0,0, 0,0), UDim2.new(0,80, 0,50), cRed)
btnX.TextSize = 30


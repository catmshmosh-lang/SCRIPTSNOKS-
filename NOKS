local Window = Fluent:CreateWindow({
    Title = "NOKS HUB",
    SubTitle = "All Worlds Instant Win",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Tabs = {
    Main = Window:AddTab({ Title = "الفرم التلقائي", Icon = "home" })
}

local Options = Fluent.Options

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local InstantWinEnabled = false
local Connection = nil

local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetHRP()
    local Char = GetCharacter()
    return Char and Char:FindFirstChild("HumanoidRootPart")
end

local function FindEndPart()
    local Keywords = {"Finish", "WinPad", "Cup", "EndPart", "End", "Win", "Goal", "FinishLine", "Victory", "Trophy"}
    local BestPart = nil
    local MaxDistance = -math.huge
    local HRP = GetHRP()
    if not HRP then return nil end

    for _, Obj in ipairs(workspace:GetDescendants()) do
        if Obj:IsA("BasePart") then
            local NameLower = string.lower(Obj.Name)
            for _, Key in ipairs(Keywords) do
                if string.find(NameLower, string.lower(Key)) then
                    local Dist = (Obj.Position - HRP.Position).Magnitude
                    if Dist > MaxDistance then
                        MaxDistance = Dist
                        BestPart = Obj
                    end
                    break
                end
            end
        end
    end
    return BestPart
end

local function StartInstantWin()
    if Connection then
        Connection:Disconnect()
        Connection = nil
    end
    Connection = RunService.RenderStepped:Connect(function()
        if not InstantWinEnabled then return end
        local HRP = GetHRP()
        if not HRP then return end
        local EndPart = FindEndPart()
        if EndPart then
            HRP.CFrame = EndPart.CFrame + Vector3.new(0, 3, 0)
        end
    end)
end

local function StopInstantWin()
    if Connection then
        Connection:Disconnect()
        Connection = nil
    end
end

Tabs.Main:AddToggle("InstantWin", {
    Title = "🔥 فوز فوري مستمر لجميع العوالم (Instant Win)",
    Default = false,
    Callback = function(Value)
        InstantWinEnabled = Value
        if Value then
            StartInstantWin()
        else
            StopInstantWin()
        end
    end
})

LocalPlayer.CharacterAdded:Connect(function()
    if InstantWinEnabled then
        task.wait(0.5)
        StartInstantWin()
    end
end)

